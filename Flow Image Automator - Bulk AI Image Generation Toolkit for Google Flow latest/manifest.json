{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Flow Image Automator - Bulk AI Image Generation Toolkit for Google Flow",
  "description": "Automate Google Labs image generation. Bulk create AI images with Nano Banana 2 and Nano Banana Pro models.",
  "version": "2.2.7",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "identity",
    "tabs",
    "scripting",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow/*",
        "https://labs.google/fx/*/tools/flow/*"
      ],
      "js": ["flowContentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["alwaysActive.js", "alwaysActiveIsolated.js"],
      "matches": ["https://labs.google/*"]
    }
  ],
  "action": {
    "default_title": "Flow Image Automator - Bulk AI Image Generation Toolkit for Google Flow & VEO AI",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "side_panel": {
    "default_path": "./src/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
