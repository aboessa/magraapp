// ملاحظة مهمة قبل استخدام هذا الملف للنشر:
//
// النطاق majarra.app يخدمه مشروع Cloudflare Pages باسم majarra-dashboard
// (فرع الإنتاج main)، وهو ما يستخدمه `npm run deploy`.
//
// محاولة ربط majarra.app بـWorker أصول عبر هذا الملف تفشل بـ:
//   Hostname 'majarra.app' already has externally managed DNS records [code: 100117]
// لأن Pages يملك سجل النطاق. الانتقال إلى Worker أصول يتطلب فصل النطاق عن
// مشروع Pages أولًا، وهو تغيير على نطاق حي بانقطاع قصير — لا يُفعل ضمنًا.
//
// يبقى هذا الملف صالحًا لـ`wrangler dev` محليًا وللمعاينة على *.workers.dev.
{
  "name": "majarra-web",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },

  // Worker للأصول الثابتة فقط، بلا main، فمخرجات Vite تُخدَم مباشرة.
  // single-page-application تعيد index.html لأي مسار غير موجود، وهو ما يحتاجه
  // react-router لمسارات مثل /admin و /plans دون أن تظهر 404.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // البيئات المسمّاة لا ترث الإعدادات من الأعلى، فتُصرّح صراحةً.
  "env": {
    "production": {
      "name": "majarra-web-prod",
      "observability": { "enabled": true },
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      // النطاق الجذر فقط. توجيه www إلى الجذر يُضبط بقاعدة Redirect Rule
      // في لوحة Cloudflare حتى لا يظهر المحتوى نفسه على نطاقين.
      "routes": [
        { "pattern": "majarra.app", "custom_domain": true }
      ]
    }
  }
}
