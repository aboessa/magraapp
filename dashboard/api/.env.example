# Copy to .env.local and fill via `wrangler secret put <NAME>`
# Vars below go in wrangler.jsonc vars; secrets go via `wrangler secret put`.

# --- Required secrets (via wrangler secret put) ---
# AUTH_TOKEN_SECRET=          # HMAC for auth tokens (required in production)
# MEDIA_TOKEN_SECRET=         # HMAC for media leases
# SEC-109: optional, only set while rotating. Verified against, never signed
# with. Delete once the window has passed — see SETUP_SECRETS.md §4.7.
# AUTH_TOKEN_SECRET_PREVIOUS=
# MEDIA_TOKEN_SECRET_PREVIOUS=
# OPS-106: where operational alerts go. Without it the monitor still records
# alerts but nobody receives them (notify_outcome='unconfigured').
# OPS_ALERT_EMAIL=
# RESEND_API_KEY=             # or Cloudflare Email binding EMAIL

# --- Optional secrets ---
# PLAYVEO_API_KEY=            # Content factory provider (paid)
# PLAYVEO_BASE_URL=           # e.g. https://api.playveo.com
# GOOGLE_TTS_API_KEY=         # or GOOGLE_TTS_SERVICE_ACCOUNT_EMAIL + PROJECT_ID + PRIVATE_KEY
# ADMIN_API_KEY=              # Legacy fallback until first admin user is seeded (then disabled)

# --- Vars (wrangler.jsonc vars / .dev.vars) ---
# PUBLIC_ASSET_BASE_URL=https://cdn.majarra.app
# EMAIL_FROM=accounts@majarra.app
# EMAIL_VERIFICATION_URL=https://majarra.app/verify
# PASSWORD_RESET_URL=https://majarra.app/reset-password
# ALLOWED_ORIGINS=https://majarra.app,https://www.majarra.app,https://api.majarra.app
# ENVIRONMENT=development
# API_VERSION=v1
# INCLUDE_TEST_FIXTURES=true

# --- Retention (PRIV-101) ---
# مدّة الاحتفاظ بصفوف analytics_events بالأيام. غيابها = 180 يومًا، وهو ما
# ينفّذه النظام اليوم لا رقمٌ جديد. الرقم **ينتظر اعتمادًا كتابيًّا** من مراجعة
# خصوصية الطفل (HUMAN-106)؛ نقلُه إلى الإعداد يجعل القرار قابلًا للتنفيذ بلا
# نشر كود، ولا ينفّذه. القيم المقبولة أعدادٌ صحيحة من 1 إلى 3650؛ وقيمة مشوّهة
# تُسجَّل بـ cleanup_retention_invalid وتعود إلى الافتراض ولا تُعطّل الحذف.
# انظر docs/DATA_RETENTION.md للجرد الكامل.
# ANALYTICS_RETENTION_DAYS=180
