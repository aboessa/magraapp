{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "npm run typecheck:types && npm test",
    "typecheck": "wrangler deploy --dry-run --outdir .wrangler-dry-run --env=",
    "typecheck:types": "tsc --noEmit",
    "types": "wrangler types",
    "deploy:staging": "echo \"staging env not configured — see docs/creative_source_of_truth.md / KIRO_LAST_REPORT.md Phase 1 — use wrangler deploy --env production after DECIDE-001\" && exit 1",
    "migrate:staging": "echo \"staging env not configured (wrangler.jsonc defines only production) — use migrate:local / migrate:remote\" && exit 1",
    "migrate:local": "wrangler d1 migrations apply majarra-db --local",
    "migrate:remote": "wrangler d1 migrations apply majarra-db --remote --env production",
    "migrate:triggers:local": "wrangler d1 execute majarra-db --local --file=scripts/child-profile-limit-triggers.sql",
    "migrate:triggers:remote": "wrangler d1 execute majarra-db --remote --env production --file=scripts/child-profile-limit-triggers.sql",
    "import:images:dry": "node scripts/import-images.mjs --dry-run",
    "import:images:local": "node scripts/import-images.mjs",
    "import:images:remote": "node scripts/import-images.mjs --remote",
    "import:wave:manifest": "node scripts/import-wave-assets.mjs --write-manifest",
    "import:wave:dry": "node scripts/import-wave-assets.mjs --dry-run",
    "import:wave:local:r2": "node scripts/import-wave-assets.mjs --local --phase=r2 --verify-r2",
    "import:wave:local:d1": "node scripts/import-wave-assets.mjs --local --phase=d1",
    "verify:wave:local": "node scripts/import-wave-assets.mjs --local --verify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.118.0"
  }
}
