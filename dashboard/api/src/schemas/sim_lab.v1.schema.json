{
  "$comment": "JSON Schema draft 2020-12. التوقع الخاطئ ليس فشلًا؛ التفسير هو ما يُقاس.",
  "title": "sim_lab level v1",
  "type": "object",
  "required": ["level", "sim", "variables", "measured", "hypothesis_options", "expected_relationships", "explanation_options", "explanation_answer", "results_table", "min_trials_before_explain", "supervision_level"],
  "additionalProperties": false,
  "properties": {
    "level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "sim": { "type": "string", "enum": ["plant_growth", "circuit", "pendulum"] },
    "variables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/variable" }
    },
    "measured": { "$ref": "#/$defs/measured" },
    "hypothesis_options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/i18nKey" }
    },
    "expected_relationships": {
      "$comment": "none تعني أن المتغير لا يؤثر — مفهوم تعليمي مقصود.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "enum": ["positive", "negative", "none", "saturating"] }
    },
    "explanation_options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/i18nKey" }
    },
    "explanation_answer": { "$ref": "#/$defs/i18nKey" },
    "results_table": {
      "$comment": "إلزامي true — الجدول متاح نصيًا لإمكانية الوصول.",
      "type": "boolean",
      "const": true
    },
    "min_trials_before_explain": { "type": "integer", "minimum": 2, "maximum": 6 },
    "supervision_level": { "type": "string", "enum": ["none", "recommended", "required"] },
    "safety_note_key": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "$comment": "أي نشاط يتطلب إشرافًا يجب أن يحمل ملاحظة سلامة.",
      "if": {
        "properties": { "supervision_level": { "const": "required" } },
        "required": ["supervision_level"]
      },
      "then": {
        "properties": { "safety_note_key": { "type": "string", "minLength": 3 } },
        "required": ["safety_note_key"]
      }
    }
  ],
  "$defs": {
    "i18nKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
    "variable": {
      "type": "object",
      "required": ["id", "label_key", "min", "max", "step", "unit_key"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label_key": { "$ref": "#/$defs/i18nKey" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "unit_key": { "$ref": "#/$defs/i18nKey" }
      }
    },
    "measured": {
      "type": "object",
      "required": ["id", "label_key", "unit_key"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label_key": { "$ref": "#/$defs/i18nKey" },
        "unit_key": { "$ref": "#/$defs/i18nKey" }
      }
    }
  }
}
