{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace_color.v1",
  "title": "trace_color content pack v1",
  "$comment": "The runtime contract for the trace_color engine. Before this version the pack schema described a single level and the actual stroke geometry for the only authored game lived in Markdown only, so nothing at runtime could read it. This describes the whole pack. Two identical copies exist by design: docs/games/schemas/ is the documented canonical location linked from the engine contract, and dashboard/api/src/schemas/ is the copy the Worker imports. test/gamePackValidation.test.mjs asserts they are identical, so they cannot drift.",
  "type": "object",
  "required": [
    "pack_version",
    "engine_id",
    "progression",
    "levels",
    "assets",
    "voice_manifest",
    "accessibility"
  ],
  "additionalProperties": false,
  "properties": {
    "pack_version": {
      "$comment": "Must not exceed the engine_version the client supports. trace_color is engine_version 1.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "engine_id": { "const": "trace_color" },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "localization": {
      "$comment": "letter modes are language_specific and are authored per language, never machine translated. Shapes and free drawing are language_neutral.",
      "type": "string",
      "enum": ["language_neutral", "translatable", "language_specific"]
    },
    "supports_dpad": {
      "$comment": "Tracing needs a pointer. The engine contract declares supports_dpad false and the pack must agree, so a TV catalogue can exclude it from data alone. Enforced as a rule rather than a const so the error can explain why.",
      "type": "boolean"
    },
    "supervision_level": {
      "type": "string",
      "enum": ["none", "recommended", "required"]
    },
    "progression": {
      "type": "object",
      "required": ["levels_to_finish", "advance_on"],
      "additionalProperties": false,
      "properties": {
        "levels_to_finish": { "type": "integer", "minimum": 1, "maximum": 10 },
        "advance_on": { "type": "string", "enum": ["level_complete", "manual"] }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/level" }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": { "type": "array", "items": { "$ref": "#/$defs/assetId" } },
        "audio": { "type": "array", "items": { "$ref": "#/$defs/assetId" } }
      }
    },
    "voice_manifest": {
      "$comment": "Semantic keys bound to audio asset ids. The mandatory key set is enforced by lib/gamePackValidation.ts rather than by `required` here, because a draft is allowed to be missing unrecorded voice-over while a publish is not, and JSON Schema cannot express that difference. trace_color additionally requires vo.stroke_complete and vo.coloring_intro per docs/games/03-voice-arabic.md.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^vo\\.[a-z_]+(\\.[A-Za-z0-9_-]+)?$": { "$ref": "#/$defs/assetId" }
      }
    },
    "accessibility": {
      "$comment": "Mandatory, not optional. The engine contract requires a simplified motor mode and a sequential-tap alternative to continuous drag; without them children with motor difficulty are excluded, so the pack cannot omit them.",
      "type": "object",
      "required": ["simplified_motor", "sequential_tap_alternative"],
      "additionalProperties": false,
      "properties": {
        "simplified_motor": {
          "type": "object",
          "required": ["tolerance_dp", "coverage_required"],
          "additionalProperties": false,
          "properties": {
            "tolerance_dp": { "type": "integer", "minimum": 24, "maximum": 64 },
            "coverage_required": { "type": "number", "minimum": 0.4, "maximum": 0.95 }
          }
        },
        "sequential_tap_alternative": { "const": true },
        "reduced_motion_supported": { "type": "boolean" },
        "min_touch_target_dp": { "type": "integer", "minimum": 40, "maximum": 96 }
      }
    },
    "review": {
      "$comment": "Human review state. Arabic letter stroke order needs a qualified reviewer; publishing claims no approval that has not happened.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linguistic_review": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "enum": ["not_required", "pending", "approved", "rejected"] },
            "reviewer": { "type": ["string", "null"] },
            "reviewed_at": { "type": ["string", "null"] },
            "notes": { "type": ["string", "null"] }
          }
        }
      }
    }
  },
  "$defs": {
    "assetId": {
      "$comment": "Must exist in content_assets with status ready before publish.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,128}$"
    },
    "i18nKey": {
      "$comment": "A semantic translation key, never human-readable text. Baked-in prose would make the pack untranslatable.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "normalizedPoint": {
      "$comment": "0..1 in pack space, resolved against the canvas at runtime, so one geometry serves every screen size.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "strokePath": {
      "type": "object",
      "required": ["id", "order", "points"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]+$" },
        "order": {
          "$comment": "Draw order. In Arabic the body precedes the dots, and the engine enforces it.",
          "type": "integer",
          "minimum": 1
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/normalizedPoint" }
        },
        "direction": { "type": "string", "enum": ["forward", "reverse"] },
        "type": {
          "$comment": "A dot is tapped, not dragged. Requiring a drag for a single point would be impossible to satisfy.",
          "type": "string",
          "enum": ["stroke", "dot"],
          "default": "stroke"
        }
      }
    },
    "coloring": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "regions": { "type": "array", "items": { "type": "string", "pattern": "^r[0-9]+$" } },
        "palette": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^#[0-9A-F]{6}$" }
        },
        "template_asset": { "$ref": "#/$defs/assetId" }
      }
    },
    "level": {
      "type": "object",
      "required": ["level", "mode", "scoring", "prompt_key", "completion"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "mode": {
          "$comment": "line/curve/shape/number/letter are the original v1 trace sub-modes and keep their meaning. The rest were added when the engine gained non-trace drawing modes.",
          "type": "string",
          "enum": [
            "line",
            "curve",
            "shape",
            "number",
            "letter",
            "path",
            "connect_dots",
            "coloring",
            "free_draw",
            "copy_pattern",
            "complete_drawing",
            "draw_from_prompt"
          ]
        },
        "scoring": {
          "$comment": "Declared in data so that 'free expression is never graded' is a property of the pack rather than a convention in client code. geometric_ordered additionally enforces stroke order. none means the level yields no score at all. Majarra has no image recognition, so no mode may claim to judge artistic quality.",
          "type": "string",
          "enum": ["geometric", "geometric_ordered", "sequence", "discrete", "none"]
        },
        "prompt_key": { "$ref": "#/$defs/i18nKey" },
        "completion": {
          "$comment": "How the level ends. all_strokes_complete for tracing, child_taps_done for free expression, which is the only honest completion rule when there is nothing to measure.",
          "type": "object",
          "required": ["rule"],
          "additionalProperties": false,
          "properties": {
            "rule": {
              "type": "string",
              "enum": ["all_strokes_complete", "all_dots_connected", "child_taps_done"]
            },
            "min_strokes": { "type": "integer", "minimum": 1 }
          }
        },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "glyph": { "type": "string", "minLength": 1, "maxLength": 4 },
        "letter_form": { "type": "string", "enum": ["isolated", "initial", "medial", "final"] },
        "writing_direction": { "type": "string", "enum": ["rtl", "ltr"] },
        "stroke_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/strokePath" }
        },
        "dots": {
          "$comment": "connect_dots ordering. Distinct from strokePath dots, which are diacritics.",
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["id", "order", "at"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^d[0-9]+$" },
              "order": { "type": "integer", "minimum": 1 },
              "at": { "$ref": "#/$defs/normalizedPoint" },
              "label_key": { "$ref": "#/$defs/i18nKey" }
            }
          }
        },
        "tolerance_dp": { "type": "integer", "minimum": 16, "maximum": 48 },
        "coverage_required": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "guide_audio": { "$ref": "#/$defs/assetId" },
        "background_asset": {
          "$comment": "Template or reference image drawn under the canvas: the glyph outline, the line art to colour, the half-finished picture to complete.",
          "$ref": "#/$defs/assetId"
        },
        "coloring": { "$ref": "#/$defs/coloring" }
      },
      "allOf": [
        {
          "$comment": "Letters carry explicit language data. Direction comes from the letter, not the interface.",
          "if": { "properties": { "mode": { "const": "letter" } }, "required": ["mode"] },
          "then": {
            "required": [
              "language",
              "glyph",
              "letter_form",
              "writing_direction",
              "guide_audio",
              "stroke_paths",
              "tolerance_dp",
              "coverage_required"
            ]
          }
        },
        {
          "if": { "properties": { "mode": { "const": "number" } }, "required": ["mode"] },
          "then": {
            "required": ["glyph", "guide_audio", "stroke_paths", "tolerance_dp", "coverage_required"]
          }
        },
        {
          "$comment": "Every geometric trace mode needs geometry and thresholds; without them there is nothing to measure against.",
          "if": {
            "properties": { "mode": { "enum": ["line", "curve", "shape", "path", "copy_pattern"] } },
            "required": ["mode"]
          },
          "then": { "required": ["stroke_paths", "tolerance_dp", "coverage_required"] }
        },
        {
          "if": { "properties": { "mode": { "const": "connect_dots" } }, "required": ["mode"] },
          "then": { "required": ["dots"] }
        },
        {
          "if": { "properties": { "mode": { "const": "coloring" } }, "required": ["mode"] },
          "then": { "required": ["coloring"] }
        }
      ]
    }
  }
}
