{
  "$comment": "JSON Schema draft 2020-12. العقد الأساس لكل حزم الألعاب.",
  "title": "Majarra game content pack (base)",
  "type": "object",
  "required": ["pack_version", "engine_id", "progression", "levels", "assets", "voice_manifest"],
  "additionalProperties": false,
  "properties": {
    "pack_version": { "type": "integer", "minimum": 1 },
    "engine_id": {
      "type": "string",
      "enum": [
        "match_pairs", "trace_color", "sort_bins", "memory_flip",
        "count_quantity", "sequence_order", "word_build", "rhythm_tap",
        "logic_pattern", "block_code", "sim_lab", "timeline_map"
      ]
    },
    "progression": {
      "type": "object",
      "required": ["levels_to_finish", "advance_on"],
      "additionalProperties": false,
      "properties": {
        "levels_to_finish": { "type": "integer", "minimum": 1, "maximum": 10 },
        "advance_on": { "type": "string", "enum": ["level_complete", "manual"] }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/levelBase" }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": { "type": "array", "items": { "$ref": "#/$defs/assetId" } },
        "audio": { "type": "array", "items": { "$ref": "#/$defs/assetId" } }
      }
    },
    "voice_manifest": {
      "type": "object",
      "$comment": "مفاتيح دلالية إلزامية مرتبطة بأصول صوتية.",
      "required": [
        "vo.intro",
        "vo.instruction",
        "vo.instruction_repeat",
        "vo.level_complete",
        "vo.game_complete",
        "vo.exit_confirm"
      ],
      "patternProperties": {
        "^vo\\.[a-z_]+(\\.[A-Za-z0-9_-]+)?$": { "$ref": "#/$defs/assetId" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "assetId": {
      "$comment": "يجب أن يوجد في content_assets وحالته ready.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,128}$"
    },
    "levelBase": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "i18nKey": {
      "$comment": "مفتاح ترجمة دلالي، لا نص مقروء.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "normalizedPoint": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  }
}
