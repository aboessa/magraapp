{
  "$comment": "JSON Schema draft 2020-12. direction=reading_order يعكس الشريط في RTL.",
  "title": "sequence_order level v1",
  "type": "object",
  "required": ["level", "sequence_type", "prompt_key", "direction", "panels", "accepted_orders"],
  "additionalProperties": false,
  "properties": {
    "level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "sequence_type": {
      "type": "string",
      "enum": ["story", "process", "procedure", "cause_effect"]
    },
    "prompt_key": { "$ref": "#/$defs/i18nKey" },
    "direction": { "type": "string", "enum": ["reading_order"] },
    "panels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/panel" }
    },
    "accepted_orders": {
      "$comment": "ترتيب واحد أو أكثر مقبول منطقيًا.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 6,
        "items": { "type": "string", "pattern": "^p[0-9]+$" }
      }
    },
    "narrate_on_complete": { "type": "boolean", "default": true }
  },
  "$defs": {
    "assetId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$" },
    "i18nKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
    "panel": {
      "type": "object",
      "required": ["id", "image", "position", "caption_key", "audio"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^p[0-9]+$" },
        "image": { "$ref": "#/$defs/assetId" },
        "position": { "type": "integer", "minimum": 1, "maximum": 6 },
        "caption_key": { "$ref": "#/$defs/i18nKey" },
        "audio": { "$ref": "#/$defs/assetId" }
      }
    }
  }
}
