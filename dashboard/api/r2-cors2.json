{
  "rules": [
    {
      "allowed": {
        "origins": ["*"],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": {
        "headers": ["ETag", "Content-Length", "Content-Type"]
      },
      "maxAgeSeconds": 3600
    },
    {
      "allowed": {
        "origins": ["http://localhost:*", "https://majarra.app", "https://*.majarra.app", "https://*.pages.dev", "http://localhost:53987", "http://127.0.0.1:*"],
        "methods": ["GET", "HEAD", "POST", "PUT", "DELETE", "OPTIONS"],
        "headers": ["*"]
      },
      "exposeHeaders": {
        "headers": ["ETag", "Content-Length", "Content-Type", "x-amz-version-id"]
      },
      "maxAgeSeconds": 3600
    }
  ]
}
