{
  "$comment": "JSON Schema draft 2020-12. mode=letter يجعل الحزمة language_specific.",
  "title": "trace_color level v1",
  "type": "object",
  "required": ["level", "mode", "stroke_paths", "tolerance_dp", "coverage_required"],
  "additionalProperties": false,
  "properties": {
    "level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "mode": { "type": "string", "enum": ["line", "curve", "shape", "number", "letter"] },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "glyph": { "type": "string", "minLength": 1, "maxLength": 4 },
    "letter_form": { "type": "string", "enum": ["isolated", "initial", "medial", "final"] },
    "writing_direction": { "type": "string", "enum": ["rtl", "ltr"] },
    "stroke_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/strokePath" }
    },
    "tolerance_dp": { "type": "integer", "minimum": 16, "maximum": 48 },
    "coverage_required": { "type": "number", "minimum": 0.5, "maximum": 1 },
    "guide_audio": { "$ref": "#/$defs/assetId" },
    "coloring": { "$ref": "#/$defs/coloring" }
  },
  "allOf": [
    {
      "$comment": "أنماط الحروف والأرقام تتطلب بيانات لغوية صريحة.",
      "if": { "properties": { "mode": { "const": "letter" } }, "required": ["mode"] },
      "then": { "required": ["language", "glyph", "letter_form", "writing_direction", "guide_audio"] }
    },
    {
      "if": { "properties": { "mode": { "const": "number" } }, "required": ["mode"] },
      "then": { "required": ["glyph", "guide_audio"] }
    }
  ],
  "$defs": {
    "assetId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$" },
    "normalizedPoint": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "strokePath": {
      "type": "object",
      "required": ["id", "order", "points"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]+$" },
        "order": {
          "$comment": "ترتيب الرسم؛ في العربية الجسم أولًا ثم النقاط.",
          "type": "integer",
          "minimum": 1
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/normalizedPoint" }
        },
        "direction": { "type": "string", "enum": ["forward", "reverse"] },
        "type": { "type": "string", "enum": ["stroke", "dot"], "default": "stroke" }
      }
    },
    "coloring": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "regions": { "type": "array", "items": { "type": "string", "pattern": "^r[0-9]+$" } },
        "palette": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^#[0-9A-F]{6}$" }
        }
      }
    }
  }
}
