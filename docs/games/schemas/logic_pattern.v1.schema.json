{
  "$comment": "JSON Schema draft 2020-12. الأشكال تُميَّز بالشكل والنقش لا باللون وحده.",
  "title": "logic_pattern level v1",
  "type": "object",
  "required": ["level", "mode", "options", "answer", "rule_key", "changing_dimensions"],
  "additionalProperties": false,
  "properties": {
    "level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "mode": {
      "type": "string",
      "enum": ["linear", "linear_alt", "matrix_2x2", "matrix_3x3", "rule_infer"]
    },
    "sequence": {
      "$comment": "للأنماط الخطية؛ null يمثل الموضع الناقص.",
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": ["string", "null"] }
    },
    "grid": {
      "$comment": "للمصفوفات؛ null يمثل الخلية الناقصة.",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "items": { "type": ["string", "null"] }
      }
    },
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/assetId" }
    },
    "answer": { "$ref": "#/$defs/assetId" },
    "rule_key": { "$ref": "#/$defs/i18nKey" },
    "changing_dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "enum": ["color", "shape", "size", "rotation", "count", "pattern"] }
    },
    "require_explanation": { "type": "boolean", "default": false },
    "explain_options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/i18nKey" }
    },
    "explain_answer": { "$ref": "#/$defs/i18nKey" }
  },
  "allOf": [
    {
      "$comment": "التعليل إلزامي في مستويات المصفوفة 3x3 واستنتاج القاعدة.",
      "if": {
        "properties": { "mode": { "enum": ["matrix_3x3", "rule_infer"] } },
        "required": ["mode"]
      },
      "then": { "required": ["require_explanation", "explain_options", "explain_answer"] }
    },
    {
      "if": { "properties": { "mode": { "enum": ["matrix_2x2", "matrix_3x3"] } }, "required": ["mode"] },
      "then": { "required": ["grid"] }
    },
    {
      "if": { "properties": { "mode": { "enum": ["linear", "linear_alt"] } }, "required": ["mode"] },
      "then": { "required": ["sequence"] }
    }
  ],
  "$defs": {
    "assetId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$" },
    "i18nKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" }
  }
}
