{
  "$comment": "JSON Schema draft 2020-12. numeral_system للعرض فقط؛ القيمة تُخزَّن عددًا.",
  "title": "count_quantity level v1",
  "type": "object",
  "required": ["level", "mode", "items"],
  "additionalProperties": false,
  "properties": {
    "level": { "type": "integer", "minimum": 1, "maximum": 10 },
    "mode": {
      "type": "string",
      "enum": ["count_and_pick", "drag_amount", "compare_sets", "pattern_fill"]
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1, "maximum": 20 }
    },
    "numeral_system": { "type": "string", "enum": ["auto", "arabic_indic", "western"], "default": "auto" },
    "items": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/anyItem" } },
    "count_aloud_on_error": { "type": "boolean", "default": true },
    "allow_recount_button": { "type": "boolean", "default": true }
  },
  "$defs": {
    "assetId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$" },
    "i18nKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
    "countSet": {
      "type": "object",
      "required": ["image", "count"],
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/$defs/assetId" },
        "count": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "anyItem": {
      "oneOf": [
        { "$ref": "#/$defs/countPickItem" },
        { "$ref": "#/$defs/compareItem" },
        { "$ref": "#/$defs/patternItem" }
      ]
    },
    "countPickItem": {
      "$comment": "count_and_pick و drag_amount",
      "type": "object",
      "required": ["id", "items", "options", "answer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^q[0-9]+$" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/countSet" } },
        "question_key": { "$ref": "#/$defs/i18nKey" },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "integer" } },
        "answer": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "compareItem": {
      "type": "object",
      "required": ["id", "set_a", "set_b", "question_key", "options", "answer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^q[0-9]+$" },
        "set_a": { "$ref": "#/$defs/countSet" },
        "set_b": { "$ref": "#/$defs/countSet" },
        "question_key": { "$ref": "#/$defs/i18nKey" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string", "enum": ["set_a", "set_b", "equal"] }
        },
        "answer": { "type": "string", "enum": ["set_a", "set_b", "equal"] }
      }
    },
    "patternItem": {
      "type": "object",
      "required": ["id", "sequence", "options", "answer", "rule_key"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^p[0-9]+$" },
        "sequence": {
          "$comment": "null يمثل الموضع الناقص، وواحد فقط مسموح.",
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "type": ["integer", "null"] }
        },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "integer" } },
        "answer": { "type": "integer" },
        "rule_key": { "$ref": "#/$defs/i18nKey" }
      }
    }
  }
}
